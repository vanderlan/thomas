root = true

[*.cs]
# Logging arguments are intentionally evaluated eagerly
dotnet_diagnostic.CA1873.severity = none

# API versioning: unversioned requests intentionally fall back to the default version (1.0)
dotnet_diagnostic.AV0016.severity = none
dotnet_diagnostic.AV0011.severity = none

# Frontend (Angular) files
[*.{ts,html,css,scss,js,json}]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

[*.md]
max_line_length = off
trim_trailing_whitespace = false
