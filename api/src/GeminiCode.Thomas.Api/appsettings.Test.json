{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "JwtOptions": {
    "SymmetricSecurityKey": "REPLACE-WITH-A-RANDOM-SECRET-OF-AT-LEAST-64-CHARACTERS-REQUIRED-FOR-HS512",
    "Issuer": "Thomas API",
    "Audience": "http://www.thomas-api.com",
