  },
  "ErrorLogSync": {
    "Enabled": false,
    "IntervalMinutes": 5,
    "InitialLookbackMinutes": 5
  },
  "NewRelic": {
    "ApiKey": "test-api-key",
    "AccountId": 1,
    "GraphQlEndpoint": "https://api.newrelic.com/graphql"
  }
}