{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "AppName": "Thomas Api",
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithMachineName"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ]
  },
  "ErrorLogSync": {
    "Enabled": true,
    "IntervalMinutes": 5,
    "InitialLookbackMinutes": 5
  },
  "NewRelic": {
    "ApiKey": "REPLACE-WITH-A-NEWRELIC-USER-API-KEY",
    "AccountId": 0,
    "GraphQlEndpoint": "https://api.newrelic.com/graphql",
    "TimeoutSeconds": 30,
    "MaxResults": 2000,
    "IncludeExpectedErrors": false
  }
}